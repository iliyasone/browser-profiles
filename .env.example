# Bearer token every /profiles request must carry. Generate one: openssl rand -hex 32
API_TOKEN=change-me

# Host directory that holds one sub-directory per profile. The browser
# containers bind-mount from here, so it must be a path on the Docker host.
HOST_DATA_DIR=/srv/browser-profiles

# Base URL the API puts into `ui_url`, i.e. how *you* reach the gateway.
PUBLIC_URL=http://localhost:8080

# Optional HTTP basic auth on every browser screen (empty = none).
BROWSER_UI_USER=
BROWSER_UI_PASSWORD=

# Stop a running profile once nobody has had its screen open for this many
# minutes; its cookies stay and the next start brings it back. 0 = never.
IDLE_STOP_MINUTES=15
